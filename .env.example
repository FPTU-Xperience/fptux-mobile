# FPTU ClubHub API Gateway (YARP) — mọi request đi qua đây.
EXPO_PUBLIC_API_URL=https://clubreporthub.duckdns.org

# Google Sign-In (react-native-nitro-google-signin).
# PHẢI là **Web OAuth client ID** (dạng xxx.apps.googleusercontent.com) — cùng giá trị
# BE dùng cho GOOGLE_CLIENT_ID. (Truyền Android client ID vào đây → DEVELOPER_ERROR;
#  ID token phải có claim aud = client ID này để BE (GOOGLE_CLIENT_ID) validate được.)
EXPO_PUBLIC_GOOGLE_CLIENT_ID=

# DEV-TOKEN MODE (fallback khi chưa cấu hình Google client ID).
# 1 access token thật (JWT) của 1 sinh viên — mọi request mobile được gắn Bearer này.
# TTL access token chỉ ~30 phút → cần nạp token mới khi hết hạn.
# Cách lấy: copy accessToken từ response login web ClubHub, hoặc BE cấp token test.
EXPO_PUBLIC_DEV_ACCESS_TOKEN=
