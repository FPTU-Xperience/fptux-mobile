# FPTU ClubHub API Gateway (YARP) — mọi request đi qua đây.
EXPO_PUBLIC_API_URL=https://clubreporthub.duckdns.org

# DEV-TOKEN MODE (Phase 7 sẽ thay bằng login thật + SecureStore).
# 1 access token thật (JWT) của 1 sinh viên — mọi request mobile được gắn Bearer này.
# TTL access token chỉ ~30 phút → cần nạp token mới khi hết hạn.
# Cách lấy (chọn 1):
#   - POST /api/auth/dev-login { email } (nếu BE enable LOCAL_DEV_LOGIN_KEY)
#   - Login 1 sinh viên trên web ClubHub, copy accessToken từ Network/Response
#   - BE cấp token test (dùng signing key dev)
EXPO_PUBLIC_DEV_ACCESS_TOKEN=
